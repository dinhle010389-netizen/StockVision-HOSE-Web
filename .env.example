# StockVision HOSE Web 0.5 Public Data Edition configuration.
# For FireAnt live bars, fill these values ONLY from FireAnt's authorized DataFeed/API specification.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=local-desktop-change-this-if-you-share-the-database
DATABASE_URL=
AUTO_CREATE_TABLES=true
DEMO_MODE=false
MARKET_DATA_PROVIDER=public
PUBLIC_DATA_AUTO_SYNC_ON_STARTUP=true
PUBLIC_DATA_SYNC_INTERVAL_MINUTES=60
PUBLIC_DATA_LOOKBACK_DAYS=730
PUBLIC_DATA_CACHE_TTL_SECONDS=900
PUBLIC_DATA_SYMBOLS=FPT,VCB,HPG,SSI,MWG,TCB,VIC,VHM
PUBLIC_DATA_INDEX_SYMBOLS=VNINDEX,VN30
FIREANT_AUTO_SYNC_ON_STARTUP=true
FIREANT_SYMBOLS=FPT,VCB,HPG,SSI,MWG,TCB,VIC,VHM
FIREANT_COUNT_BACK=250
FIREANT_TIMEOUT_SECONDS=12
FIREANT_BASE_URL=https://api.fireant.vn
FIREANT_API_TOKEN=
FIREANT_LICENSE_CONFIRMED=false
FIREANT_BARS_PATH=
FIREANT_BARS_QUERY_JSON={}
FIREANT_BARS_DATA_KEY=data
FIREANT_AUTH_SCHEME=Bearer
FIREANT_BAR_FIELD_MAP_JSON={"date":"date","open":"open","high":"high","low":"low","close":"close","volume":"volume","value":"value","adjusted_close":"adjustedClose","is_final":"isFinal"}
